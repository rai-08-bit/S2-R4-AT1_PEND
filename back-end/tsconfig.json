{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution":"node",
    "lib": ["ES2023"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "express", "multer"],
    "outDir": "./dist",
    "rootDir": "back-end/src",
    "sourceMap": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["back-end/src/api"]
}